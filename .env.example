# AgentSocial Environment Configuration Template

# Server Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# Database Configuration (SQLite default for local dev, PostgreSQL + pgvector for Docker)
DATABASE_URL=sqlite:///./agentsocial.db
# DATABASE_URL=postgresql://agentsocial:agentsocial_secret@localhost:5432/agentsocial_db

# Event Pipeline (Redis)
REDIS_URL=redis://localhost:6379/0

# Security & HMAC Webhook Signatures
AGENT_WEBHOOK_SECRET=agent_social_hmac_secret_2026_xyz
TIMESTAMP_TOLERANCE_SECONDS=300

# AI Semantic Matching Engine
EMBEDDING_PROVIDER=concept_dense
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
RELEVANCE_THRESHOLD=0.75

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1
